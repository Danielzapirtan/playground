#! /usr/bin/bash

PATH=/usr/bin:/bin
DATE=$(date +%Y%m%d_%H%M%S)
DIR=..
PROJECT=$(basename $PWD)
EXCLUDE=$PROJECT/.exclude.txt
TARGETDIR=/var/backups/code/$PROJECT
TARGET=$TARGETDIR/${PROJECT}_$DATE.tar.gz

cd $DIR
: >$EXCLUDE
for d in "venv" ".venv" ".git"; do
  find $PROJECT -type d -iname $d >>$EXCLUDE
done

sudo mkdir -p $TARGETDIR
sudo tar -C . -X $EXCLUDE -czf $TARGET $PROJECT
